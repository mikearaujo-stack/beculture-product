# Banco (casa com docker-compose.yml)
DATABASE_URL="postgresql://beculture:beculture@localhost:5432/beculture?schema=public"

# Auth — mínimo de 32 caracteres (a API recusa segredos curtos). Gere com:
#   openssl rand -base64 48
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# Servidor
PORT=3001
# Origem do frontend (Vite) para CORS
CORS_ORIGIN="http://localhost:5173"

# Iugu (Fase 2 — billing real). Deixe em branco para usar o billing simulado.
IUGU_API_TOKEN=""

# IA gerenciada no TRIAL (nossa chave Anthropic). Em branco = sem modo gerenciado.
ANTHROPIC_API_KEY=""
# Modelo do modo gerenciado (trial). Tenants escolhem o próprio em Conexões.
AI_MODEL="claude-opus-4-8"

# Criptografia das chaves de IA dos tenants (BYOK). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# Conector Slack (OAuth). Crie o app em https://api.slack.com/apps com os
# bot scopes: channels:read, chat:write, chat:write.public, users:read, e
# cadastre a Redirect URL abaixo no app. Em branco = botão "Conectar" do
# Slack mostra "não configurado".
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
# O Slack exige HTTPS na Redirect URL — em dev local, use um túnel
# (ex.: ngrok http 3001) e aponte para <url-do-tunel>/conectores/slack/callback
SLACK_REDIRECT_URL="http://localhost:3001/conectores/slack/callback"
# Enquanto o app não tiver "Public Distribution" ativa, ele só instala no
# workspace onde foi criado — em outro, o Slack recusa com
# `invalid_team_for_non_distributed_app`. Preencha com o ID do workspace de
# desenvolvimento (o T... da URL do Slack no navegador) para forçar a tela de
# consentimento nele. Com distribuição ativa, deixe em branco.
SLACK_TEAM_ID=""

# Conector Gmail (OAuth). Crie as credenciais "OAuth client ID" (tipo Web
# application) em https://console.cloud.google.com/apis/credentials, habilite
# a Gmail API no projeto e cadastre a Redirect URL abaixo em "Authorized
# redirect URIs". Em branco = "Conectar" do Gmail mostra "não configurado".
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URL="http://localhost:3001/conectores/email/gmail/callback"

# Conector Google Calendar (OAuth). Usa o MESMO GOOGLE_CLIENT_ID/SECRET acima
# (um só app no Google Cloud) — habilite também a Google Calendar API no
# projeto e cadastre esta segunda Redirect URL em "Authorized redirect URIs".
GOOGLE_CALENDAR_REDIRECT_URL="http://localhost:3001/conectores/agenda/google-calendar/callback"

# Conector Outlook (OAuth). Registre o app em https://entra.microsoft.com
# (Identidade → Aplicativos → Registros de aplicativo), com as permissões
# delegadas Mail.Read, Mail.Send, User.Read e offline_access, e cadastre a
# Redirect URL abaixo como plataforma "Web".
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# "common" aceita contas corporativas e pessoais; use o id do tenant para
# restringir o login à sua organização.
MICROSOFT_TENANT_ID="common"
MICROSOFT_REDIRECT_URL="http://localhost:3001/conectores/email/outlook/callback"

# Para onde devolver o navegador ao fim do fluxo OAuth (página Conectores).
FRONT_URL="http://localhost:5173"
