// Schema do beculture — multi-tenant (Empresa = tenant) + billing.
// Espelha os tipos que o frontend já define em:
//   ts/demo/src/app/contexts/companies/context.ts
//   ts/demo/src/services/billing/types.ts

generator client {
  provider      = "prisma-client-js"
  // "native" cobre o dev local; "debian-openssl-3.0.x" cobre o container
  // (node:20-slim / Railway / Render); "rhel-openssl-3.0.x" cobre a
  // Amazon Linux das Vercel Functions.
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Runtime usa a URL pooled do Neon; migrations usam a conexão direta
  // (o pooler não suporta DDL).
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ---------- Enums (códigos compartilhados com o front) ----------

enum TipoPessoa {
  pj
  pf
}

enum PlanoCode {
  basico
  profissional
  corporativo
}

enum CicloCobranca {
  mensal
  anual
}

enum ModuloCode {
  ia_pessoal
  performance
  learning
  recrutamento
  projetos
}

enum UserRole {
  owner
  admin
  membro
}

enum ConviteStatus {
  pendente
  aceito
}

enum MembroStatus {
  ativo
  convite_pendente
  inativo
}

/// Que ESPÉCIE de vínculo a pessoa tem com a organização — não confundir com
/// `MembroStatus`, que diz em que ponto do onboarding ela está. Os dois eixos
/// são independentes: existe convidado ativo, convidado com convite pendente e
/// convidado inativo.
///
/// `convidado` é acesso externo: fica FORA da estrutura organizacional (sem
/// área, sem cargo, sem posição na hierarquia), não pode ser gestor de ninguém
/// e carrega exclusivamente a role de sistema `convidado`.
///
/// A distinção é estrutural, e não "uma role chamada Convidado", porque ela
/// decide coisas que role nenhuma decide: quem entra no organograma, quem pode
/// ser apontado como gestor, e quais campos o cadastro sequer oferece.
enum MembroTipo {
  membro
  convidado
}

enum RoleTipo {
  sistema
  personalizada
}

/// Ciclo de vida de uma entidade de estrutura (Área, Cargo). Compartilhado
/// pelas duas de propósito: a semântica é idêntica, e um enum por entidade
/// exigiria dois ALTER TYPE a cada evolução.
///
/// `inativo` NÃO remove associações: quem já está na área continua nela. O
/// status só decide se a entidade aparece como opção NOVA. É o que permite
/// desativar sem exclusão destrutiva.
enum EstruturaStatus {
  ativo
  inativo
}

enum StatusAssinatura {
  trial
  ativa
  inadimplente
  expirada
  cancelada
}

enum MetodoPagamento {
  pix
  cartao
  boleto
}

enum AiProvider {
  anthropic
  openai
}

enum AiConnectionStatus {
  ativa
  invalida
}

enum AiMediaKind {
  image
  video
}

enum MemoriaConfianca {
  alta
  media
  baixa
}

// ---------- Modelos ----------

/// O tenant que contrata (identidade + plano escolhido).
model Empresa {
  id                    String        @id @default(cuid())
  tipoPessoa            TipoPessoa
  documento             String // CNPJ (PJ) ou CPF (PF), com máscara
  razaoSocial           String
  nomeFantasia          String?
  plano                 PlanoCode
  ciclo                 CicloCobranca
  modulos               ModuloCode[]
  setor                 String?
  onboardingConcluidoEm DateTime?
  criadoEm              DateTime      @default(now())

  usuarios            Usuario[]
  convites            Convite[]
  membros             Membro[]
  roles               Role[]
  areas               Area[]
  cargos              Cargo[]
  marcas              Marca[]
  assinatura          Assinatura?
  aiCredentials       AiCredential[]
  aiConnections       AiConnection[]
  aiMediaConnections  AiMediaConnection[]
  memorias            Memoria[]
  insights            Insight[]
  vaultNotas          VaultNota[]
  vaultCategorias     VaultCategoria[]
  vaultNotaCategorias VaultNotaCategoria[]
  conversas           Conversa[]
  conectores          EmpresaConector[]
  mcpApiKeys          McpApiKey[]
  aiUsage             AiUsage[]

  @@map("empresas")
}

/// Quem faz login; o trial (14 dias) é contado por usuário.
model Usuario {
  id            String   @id @default(cuid())
  empresaId     String
  nome          String
  email         String   @unique
  senhaHash     String
  telefone      String?
  avatarUrl     String?
  role          UserRole @default(membro)
  trialStartsAt DateTime
  trialEndsAt   DateTime
  criadoEm      DateTime @default(now())

  empresa   Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  squadPins SquadPin[]
  membros   Membro[]
  conversas Conversa[]
  aiUsage   AiUsage[]

  @@index([empresaId])
  @@map("usuarios")
}

/// Convite de um membro do time (criado no onboarding).
model Convite {
  id        String        @id @default(cuid())
  empresaId String
  email     String
  role      UserRole      @default(membro)
  status    ConviteStatus @default(pendente)
  criadoEm  DateTime      @default(now())

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, email])
  @@index([empresaId])
  @@map("convites")
}

/// Vínculo pessoa <-> organização: quem faz parte do time e com quais dados
/// organizacionais (área, cargo, status). É a entidade canônica de "Membro".
///
/// Separação proposital de `Usuario`:
///   Usuario = credencial de login (e-mail unique GLOBAL, senhaHash, avatar).
///   Membro  = pertencimento a UM tenant + dados de estrutura organizacional.
/// `usuarioId` é nulo enquanto a pessoa ainda não tem conta (convite_pendente),
/// que é como a V1 cria um membro sem senha e sem tocar em auth.
///
/// A V1 não tem papel/permissão/hierarquia de propósito. As evoluções previstas
/// entram como colunas nuláveis AQUI: areaId/cargoId (V2, Áreas e Cargos como
/// entidades), gestorId -> membros.id (V3), papel (V4), escopo (V5).
///
/// `nome`/`email` são duplicados em relação a `Usuario` por design: `Membro` é
/// autoritativo para exibição e o MembrosService é o único caminho de escrita.
/// Se algum dia existir um PATCH /user/profile, ele precisa espelhar para cá.
model Membro {
  id        String  @id @default(cuid())
  empresaId String
  /// Conta de login vinculada. Nulo = convidado que ainda não tem conta.
  usuarioId String?

  nome  String
  /// Normalizado (trim + lowercase) no service: a unique do Postgres é
  /// case-sensitive, então a normalização é o que a torna efetiva.
  email String
  /// LEGADO (pré-V4). Guardam o CÓDIGO do catálogo estático que existia em
  /// ts/demo/src/app/data/{areas,cargos}.ts. Substituídos por `areaId`/
  /// `cargoId` e NUNCA MAIS ESCRITOS — ficam congelados como histórico e como
  /// fallback de exibição de quem ainda não foi reconfigurado. Não houve
  /// backfill de propósito: nenhum registro existente foi tocado.
  ///
  /// Não remover nem renomear: o `forbidNonWhitelisted` do bootstrap faria um
  /// bundle antigo, que ainda envia estes campos, receber 400 em todo save.
  area  String?
  cargo String?

  status MembroStatus @default(convite_pendente)

  /// V8 — `membro` por DEFAULT, e é o default que torna esta coluna aditiva:
  /// toda linha que já existia continua sendo membro da organização, e nenhuma
  /// vira convidada sozinha.
  ///
  /// Sem índice de propósito. Nenhuma consulta filtra por tipo no servidor — a
  /// listagem devolve o tenant inteiro e o recorte é no cliente —, então um
  /// `@@index([empresaId, tipo])` existiria para uma query que não existe.
  tipo MembroTipo @default(membro)

  /// LEGADO (pré-V6). Guardava a role ÚNICA do membro. Substituída por
  /// `MembroRole`, que permite até duas, e lida pela última vez no backfill
  /// da migration `membro_roles_multiplas`. O código novo não a escreve.
  ///
  /// Atenção, e é o que a distingue das outras colunas legadas deste model:
  /// `area`/`cargo` são texto puro e ficaram realmente congelados, mas esta
  /// tem FK com ON DELETE SET NULL — então o BANCO continua zerando-a quando
  /// uma role é excluída. Ela não serve de histórico nem de auditoria.
  ///
  /// Não remover: o `forbidNonWhitelisted` do bootstrap faria um bundle
  /// antigo, que ainda envia `roleId`, receber 400 em todo save. O DTO a
  /// aceita e IGNORA.
  ///
  /// NÃO confundir com `Usuario.role` (owner/admin/membro): aquele é o papel
  /// da CONTA e segue sendo o gate legado da API; este é a camada nova de
  /// permissões da plataforma. Owner continua protegido por lá.
  roleId String?

  /// V4 — Estrutura. Área e Cargo como entidades da organização, no lugar dos
  /// códigos de texto acima. Nulo é estado válido: é como fica todo membro
  /// cadastrado antes desta versão, até que alguém escolha a entidade.
  ///
  /// Uma área e um cargo por membro. Área responde ONDE a pessoa está alocada,
  /// Cargo QUAL posição profissional ocupa. Nenhuma das duas concede permissão
  /// (isso é `roleId`) nem define hierarquia (isso é `gestorId`).
  areaId  String?
  cargoId String?

  /// V2 — Hierarquia. Gestor direto: a quem este membro responde. Nulo =
  /// topo da estrutura (ou relação ainda não configurada), estado válido.
  /// É a única relação hierárquica ESTRUTURAL: subordinados, cadeia acima e
  /// árvore inteira são derivados dela. Deliberadamente não há coluna de
  /// nível, para não existir dado que possa divergir das relações.
  ///
  /// V7 acrescentou `MembroGestorIndireto`, que é relação de gestão mas NÃO
  /// entra aqui: a árvore continua sendo montada só por `gestorId`, e é essa
  /// separação que mantém uma posição por membro. Ver o model.
  ///
  /// Cargo NÃO define hierarquia: dois gerentes podem estar em cadeias
  /// diferentes, e Área é só contexto organizacional.
  gestorId String?

  /// Trilha mínima de auditoria. A V1 não envia e-mail; só registra o momento.
  convidadoEm  DateTime?
  desativadoEm DateTime?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  empresa                       Empresa                @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  /// SetNull e não Cascade: apagar uma conta não apaga o histórico do vínculo.
  usuario                       Usuario?               @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  /// Auto-relação. SetNull e não Cascade: se o gestor deixar de existir
  /// (cancelamento de um convite que era gestor), a equipe dele fica sem
  /// gestor em vez de ser apagada junto.
  gestor                        Membro?                @relation("MembroGestor", fields: [gestorId], references: [id], onDelete: SetNull)
  subordinados                  Membro[]               @relation("MembroGestor")
  /// V7 — Gestores indiretos. `gestoresIndiretos` é a lista DESTE membro;
  /// `atribuicoesComoGestorIndireto` são as linhas em que ele é o apontado.
  ///
  /// O segundo NÃO se chama `subordinadosIndiretos` de propósito: apontar
  /// alguém como gestor indireto não torna ninguém subordinado dele para
  /// efeito nenhum — nem de estrutura, nem de acesso a dados, nem de
  /// permissão. O nome descreve linhas de junção, não pessoas.
  ///
  /// Nenhum dos dois é consultado em lugar algum (o Prisma exige o lado
  /// inverso), exatamente como `subordinados` acima. Não são peso morto a
  /// limpar: sem eles o schema não valida.
  gestoresIndiretos             MembroGestorIndireto[] @relation("MembroGestoresIndiretos")
  atribuicoesComoGestorIndireto MembroGestorIndireto[] @relation("MembroComoGestorIndireto")
  /// LEGADO, junto de `roleId`. SetNull: excluir uma role nunca deixa membro
  /// apontando para id inexistente — e é justamente esse SetNull que faz a
  /// coluna continuar mudando depois de "congelada".
  role                          Role?                  @relation(fields: [roleId], references: [id], onDelete: SetNull)
  /// V6 — Acesso. As roles do membro (até duas). Fonte de verdade das
  /// permissões efetivas, que são a UNIÃO das permissões destas roles.
  rolesAtribuidas               MembroRole[]
  /// `areaRef`/`cargoRef` e não `area`/`cargo`: os escalares legados acima
  /// ocupam esses nomes, e nome de campo é único por model no Prisma. A API
  /// expõe exatamente estes nomes, então front e banco falam a mesma língua.
  ///
  /// SetNull, mesma escolha de `role`: o service já recusa excluir uma Área em
  /// uso (409 com a contagem), e isto é só a rede — nenhum membro fica
  /// apontando para id inexistente. Restrict quebraria o Cascade de Empresa,
  /// porque o Postgres o checa na hora e a ordem das deleções filhas não é
  /// garantida.
  areaRef                       Area?                  @relation(fields: [areaId], references: [id], onDelete: SetNull)
  cargoRef                      Cargo?                 @relation(fields: [cargoId], references: [id], onDelete: SetNull)

  @@unique([empresaId, email])
  /// Composta (e não unique em usuarioId sozinho) para não travar a V2+, em que
  /// um usuário pode pertencer a mais de uma organização. No Postgres NULLs
  /// múltiplos são permitidos, então N convidados sem conta convivem aqui.
  @@unique([empresaId, usuarioId])
  @@index([empresaId])
  @@index([empresaId, status])
  /// Serve "quem responde a este gestor?", a consulta base da árvore.
  @@index([empresaId, gestorId])
  /// Peso morto desde a V6: nada consulta mais `roleId`. Fica porque removê-lo
  /// exigiria um DROP INDEX numa migration que se propôs a ser só aditiva.
  @@index([empresaId, roleId])
  /// Servem a contagem de membros por área/cargo, que é o número exibido nas
  /// duas listagens de Estrutura.
  @@index([empresaId, areaId])
  @@index([empresaId, cargoId])
  @@map("membros")
}

/// V3 — Acesso. Uma Role responde "o que o membro PODE FAZER" na plataforma.
///
/// Separação proposital em relação ao resto da estrutura organizacional:
///   Área    = onde a pessoa trabalha
///   Cargo   = qual posição profissional ocupa
///   Gestor  = a quem responde
///   Role    = o que pode fazer no sistema
/// Nenhum desses infere o outro. Um analista pode ter role Admin e um diretor
/// pode ter role Viewer — e isso tem de continuar sendo possível.
///
/// `permissoes` é text[] de códigos do catálogo (src/acesso/permissoes.catalog.ts),
/// e não enum nem tabela de vínculo: o catálogo cresce a cada funcionalidade
/// nova, e um enum exigiria ALTER TYPE a cada mexida. A validação e a
/// normalização das dependências ficam no service, então o que é gravado nunca
/// é incoerente. Mesma escolha já feita em `Empresa.modulos`.
///
/// O que a Role NÃO responde nesta versão: sobre QUAIS dados a permissão vale.
/// Isso é escopo de acesso, e entra na V4 como colunas/tabela própria aqui.
model Role {
  id        String @id @default(cuid())
  empresaId String

  nome      String
  descricao String?
  tipo      RoleTipo @default(personalizada)
  /// Chave estável das roles de sistema (admin | editor | viewer). Nula nas
  /// personalizadas. É por aqui que o upsert idempotente as reconhece, em vez
  /// de depender do nome, que é texto livre.
  codigo    String?

  /// Códigos de permissão do catálogo. Sempre normalizado pelo service.
  permissoes String[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  empresa           Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  /// LEGADO: o lado inverso de `Membro.roleId`. Não contar membros por aqui —
  /// a contagem exibida vem de `membrosAtribuidos`.
  membros           Membro[]
  /// V6 — Acesso. Os vínculos desta role. `_count.membrosAtribuidos` é a
  /// contagem de membros que a listagem e o modal de exclusão mostram.
  membrosAtribuidos MembroRole[]

  /// Nome único no tenant: a listagem identifica role por nome, e dois "Editor"
  /// na mesma organização seriam indistinguíveis para quem administra.
  @@unique([empresaId, nome])
  /// Uma role de sistema por código, por organização.
  @@unique([empresaId, codigo])
  @@index([empresaId])
  @@map("roles")
}

/// V6 — Acesso. Vínculo membro↔role: é o que permite até DUAS roles por membro.
///
/// Tabela de vínculo, e não uma segunda coluna FK em `Membro`: `roleId` +
/// `roleId2` codificaria ordem, e as roles de um membro NÃO têm prioridade
/// entre si — o acesso efetivo é a UNIÃO das permissões, que é comutativa.
/// `Editor + Gestor` e `Gestor + Editor` têm de dar o mesmo resultado.
///
/// Deliberadamente SEM coluna de slot/ordem, ao contrário de `SquadPin`, que é
/// o modelo de junção que este copia em todo o resto. Um `slot Int` com
/// `@@unique([membroId, slot])` e um CHECK (slot IN (0,1)) daria o teto de duas
/// no próprio banco — e seria exatamente o conceito de role principal /
/// secundária que esta versão recusa. O teto vive no service
/// (`MAX_ROLES_POR_MEMBRO`); não troque um pelo outro depois.
///
/// Sem `empresaId`, também como `SquadPin`: os dois lados são FK real, então o
/// Cascade de `Empresa` alcança esta tabela por Membro E por Role. As outras
/// junções do schema (VaultNotaCategoria, EmpresaConector) carregam `empresaId`
/// porque um dos lados delas é texto, não FK. Denormalizá-lo aqui criaria uma
/// terceira fonte capaz de divergir das duas.
model MembroRole {
  id       String   @id @default(cuid())
  membroId String
  roleId   String
  criadoEm DateTime @default(now())

  /// Cascade nos dois lados: o vínculo é a associação viva, não histórico.
  /// Excluir a role apaga o vínculo, mas o service ainda exige resolução
  /// explícita antes (ver `RolesService.remover`) — isto é só a rede do banco.
  membro Membro @relation(fields: [membroId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  /// Impede a mesma role duas vezes no mesmo membro, no próprio banco.
  @@unique([membroId, roleId])
  /// Serve "quais membros têm esta role?" — a contagem da aba Acesso e o
  /// `where` da substituição na exclusão. O prefixo da unique já cobre
  /// `membroId`, então não há índice para ele.
  @@index([roleId])
  @@map("membro_roles")
}

/// V7 — Hierarquia. Gestores indiretos de um membro: as outras lideranças que
/// têm relação de gestão, acompanhamento ou influência sobre ele.
///
/// O SEGUNDO tipo de relação de gestão, e o contraste com `Membro.gestorId` é
/// a razão de existir desta tabela:
///
///   gestorId (1)  → define a POSIÇÃO do membro. A árvore é montada só com ela.
///   esta tabela (N) → relações COMPLEMENTARES sobre os mesmos nós.
///
/// Não virou `gestorId2`, nem uma lista em `Membro`, nem um segundo tipo
/// dentro de uma tabela só com coluna de tipo: misturar as duas na mesma
/// estrutura tornaria "qual delas define a posição?" uma pergunta de runtime,
/// e a árvore passaria a depender de um filtro em vez da forma do dado.
///
/// DIRECIONAL. `(membroId: M, gestorIndiretoId: G)` significa "G acompanha M"
/// e não cria nada no sentido inverso — G continua sem relação nenhuma com M
/// até que alguém cadastre a linha oposta, que é permitida e independente.
///
/// NÃO concede nada. Gestor indireto não dá acesso a dados, não entra em
/// `permissoesEfetivas`, não sugere role e não coloca o membro na "equipe" de
/// ninguém para fins de autorização. Essa separação é o ponto: sem ela, editar
/// a estrutura organizacional passaria a ampliar acesso em silêncio.
///
/// NUNCA é derivada. Uma cadeia `Carolina → Renato → Michael` não gera
/// `(Michael, Carolina)` aqui: superior hierárquico já é dedutível de
/// `gestorId`, e materializá-lo criaria dado redundante capaz de divergir da
/// árvore. Toda linha desta tabela foi cadastrada explicitamente por alguém.
///
/// Sem `empresaId`, pela mesma regra de `MembroRole`: os dois lados são FK
/// real para `Membro`, então o Cascade de `Empresa` alcança esta tabela por
/// dois caminhos, e denormalizar criaria uma terceira fonte capaz de divergir.
/// Mas seja honesto sobre o que isso NÃO protege: nada no DDL barra um par
/// entre membros de organizações diferentes. O único guarda é o
/// `where: { id, empresaId }` de `exigirGestoresDoTenant` no service — como
/// já acontece com `MembroRole` (membro de A + role de B). É uma escolha,
/// não uma prova.
model MembroGestorIndireto {
  id String @id @default(cuid())

  /// Dono da lista: de quem estes são os gestores indiretos.
  membroId         String
  /// Apontado como gestor indireto.
  gestorIndiretoId String

  criadoEm DateTime @default(now())

  /// Cascade nos dois lados, ao contrário do SetNull de `gestorId`: lá a
  /// linha apagada seria uma PESSOA, e a equipe dela tem de sobreviver sem
  /// gestor. Aqui a linha É a relação — sem os dois membros ela não significa
  /// nada, e apagá-la não deixa ninguém sem posição na estrutura. É isto que
  /// faz a exclusão de um membro não exigir realocação dos indiretos.
  membro         Membro @relation("MembroGestoresIndiretos", fields: [membroId], references: [id], onDelete: Cascade)
  gestorIndireto Membro @relation("MembroComoGestorIndireto", fields: [gestorIndiretoId], references: [id], onDelete: Cascade)

  /// Impede o mesmo gestor indireto duas vezes no mesmo membro, no banco.
  /// A auto-associação é barrada por um CHECK escrito à mão na migration (o
  /// Prisma não expressa CHECK). Já a regra "o gestor DIRETO não pode estar
  /// nesta tabela" compara com `membros.gestorId`, em outra tabela: não cabe
  /// aqui e vive em `resolverGestoresIndiretos`.
  @@unique([membroId, gestorIndiretoId])
  /// Serve "de quem esta pessoa é gestora indireta?". O prefixo da unique já
  /// cobre `membroId`, então não há índice para ele.
  @@index([gestorIndiretoId])
  @@map("membro_gestores_indiretos")
}

/// V4 — Estrutura. Área organizacional: ONDE a pessoa está alocada.
///
/// Substitui o catálogo estático que vivia em ts/demo/src/app/data/areas.ts,
/// onde as 11 áreas eram iguais para toda organização. Agora cada empresa
/// administra as suas.
///
/// O que a Área deliberadamente NÃO tem:
///   • responsável/gestor da área — liderança entre pessoas é só
///     `Membro.gestorId`, e uma segunda fonte de verdade para isso seria pior
///     do que a ausência do campo;
///   • área superior/subáreas — a estrutura é plana nesta versão;
///   • permissão de qualquer tipo — quem responde "o que pode fazer" é a Role.
///
/// A Área é contexto organizacional. Uma regra de acesso pode um dia dizer
/// "conforme a área do membro" e usar isto para resolver o alcance dos dados,
/// mas a permissão continua vindo da Role, e o vínculo com repositório terá de
/// ser estruturado — nunca inferido por semelhança de nome.
///
/// Nunca é excluída em silêncio: desativar (`status = inativo`) é o caminho
/// normal e preserva registro, histórico e as associações existentes. A
/// exclusão é recusada com 409 enquanto houver membros.
model Area {
  id        String @id @default(cuid())
  empresaId String

  nome      String
  /// Só informativa: não tem efeito sobre permissão, hierarquia ou acesso.
  descricao String?

  status EstruturaStatus @default(ativo)

  /// Trilha mínima, mesmo par status/timestamp de `Membro`.
  desativadoEm DateTime?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  empresa Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  membros Membro[]

  /// A quantidade de membros da área é SEMPRE derivada desta relação
  /// (`_count`), nunca uma coluna: um contador gravado divergiria na primeira
  /// edição de membro feita por outro caminho.
  ///
  /// Nome único no tenant: a listagem e o seletor do membro identificam a área
  /// pelo nome, e duas "Produto" seriam indistinguíveis para quem administra.
  /// A unique do Postgres é case-sensitive, então o service ainda faz o
  /// pré-check case-insensitive — mesma relação entre unique e normalização de
  /// `Membro.email`.
  @@unique([empresaId, nome])
  @@index([empresaId])
  @@map("areas")
}

/// V4 — Estrutura. Cargo: QUAL POSIÇÃO profissional a pessoa ocupa.
///
/// Modelo gêmeo de `Area` de propósito, e não uma tabela única com um
/// discriminador `tipo`: são duas telas administradas separadamente, e um
/// discriminador obrigaria todo `where` a carregá-lo para não misturar as
/// duas listas.
///
/// Cargo NÃO define hierarquia. Dois membros com o mesmo cargo podem ter
/// relação hierárquica entre si, e alguém com cargo aparentemente superior
/// pode não ser gestor de ninguém. A fonte de verdade é `Membro.gestorId`.
/// Também NÃO concede permissão: isso é `Role`.
///
/// Senioridade não é campo separado nesta versão — o cargo é completo
/// ("Product Designer Sênior"). Sem níveis, grades, bands, trilhas de
/// carreira ou faixa salarial.
model Cargo {
  id        String @id @default(cuid())
  empresaId String

  nome      String
  /// Só informativa, igual à descrição da Área.
  descricao String?

  status EstruturaStatus @default(ativo)

  desativadoEm DateTime?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  empresa Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  membros Membro[]

  @@unique([empresaId, nome])
  @@index([empresaId])
  @@map("cargos")
}

/// V5 — Guia de marca (design system) da organização. Configurações › Geral ›
/// Aparência › Guia de marca.
///
/// Substitui o store de localStorage que vivia em
/// ts/demo/src/app/pages/ceo/design-system/store.ts, onde as marcas eram por
/// NAVEGADOR: quem criava a marca num computador não a via no outro, e ninguém
/// da organização via a marca de ninguém. Agora pertencem à empresa, que é o
/// que o isolamento por `empresaId` garante na camada de dados.
///
/// O que a Marca deliberadamente NÃO tem:
///   • status/desativadoEm — ao contrário de Area e Cargo, NADA referencia uma
///     Marca (nenhuma tela persiste o id; as telas de IA enviam o documento
///     inteiro na hora de gerar), então excluir não desfaz vínculo nenhum e o
///     soft-delete só acrescentaria um filtro a toda query;
///   • marca ativa — QUAL marca está selecionada é preferência do USUÁRIO
///     naquele navegador, não da organização, e continua no localStorage.
model Marca {
  id        String @id @default(cuid())
  empresaId String

  /// Denormalizado de `conteudo.marca.nome`. O service grava os DOIS na mesma
  /// escrita, sempre, com o mesmo valor já aparado. Existe como coluna porque
  /// a unique e a ordenação da listagem precisam de uma, e um caminho dentro
  /// do Json não sustenta índice único no Prisma.
  nome String

  /// O DesignSystem inteiro MENOS os logos — a mesma forma de
  /// ts/demo/src/app/pages/ceo/design-system/types.ts (marca, cores,
  /// tipografia, espacamento, componentes, visual, tokens).
  ///
  /// Json e não ~45 colunas: é um documento que só o editor lê e escreve, e
  /// sempre por inteiro. O contrato é mantido pelos DTOs aninhados, que é onde
  /// os limites de tamanho por campo são aplicados.
  conteudo Json

  /// Data URLs (image/png|jpeg|svg+xml|webp), como o FileReader do editor as
  /// produz. FORA do `conteudo` de propósito: são o único campo que passa de
  /// alguns KB, e separá-los deixa a listagem poder omiti-los no futuro sem
  /// tocar no formato do documento.
  logoClaro  String? @db.Text
  logoEscuro String? @db.Text

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  /// Nome único no tenant: a tabela de Configurações e o seletor de marca do
  /// AI Studio identificam a marca pelo nome. A unique do Postgres é
  /// case-sensitive, então o service ainda faz o pré-check insensitive — mesma
  /// relação entre unique e normalização já documentada em `Area`.
  @@unique([empresaId, nome])
  @@index([empresaId])
  @@map("marcas")
}

/// Assinatura/cobrança da empresa (1:1). Snapshot de preços no momento.
model Assinatura {
  id              String           @id @default(cuid())
  empresaId       String           @unique
  plano           PlanoCode
  ciclo           CicloCobranca
  modulos         ModuloCode[]
  /// Plano e quantidade por módulo (modelo da calculadora): [{modulo, plano, quantidade}].
  configuracoes   Json?
  status          StatusAssinatura @default(trial)
  usuarios        Int              @default(0)
  posicoes        Int              @default(0)
  precoUsuario    Float            @default(0)
  precoPosicao    Float            @default(0)
  total           Float            @default(0)
  sobConsulta     Boolean          @default(false)
  trialStartsAt   DateTime
  trialEndsAt     DateTime
  criadoEm        DateTime         @default(now())
  ativadaEm       DateTime?
  metodoPagamento MetodoPagamento?
  gatewayRef      String? // referência do objeto na Iugu

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@map("assinaturas")
}

/// Chave de API de um provedor (BYOK). N por empresa: a mesma empresa de IA
/// pode ter várias chaves (Produção / Backup). A chave é criptografada em
/// repouso e nunca volta crua. Os modelos de Texto/Imagem/Vídeo apontam para cá.
model AiCredential {
  id              String             @id @default(cuid())
  empresaId       String
  /// Id do provedor (ex.: "anthropic", "openai", "heygen") — union dos catálogos.
  provider        String
  /// Apelido opcional para distinguir duas chaves do mesmo provedor.
  nome            String?
  /// Chave de API do provedor, criptografada (AES-256-GCM). NUNCA exposta crua.
  apiKeyEncrypted String
  /// Últimos 4 dígitos da chave, apenas para exibição.
  keyLast4        String
  status          AiConnectionStatus @default(ativa)
  validatedAt     DateTime?
  criadoEm        DateTime           @default(now())
  atualizadoEm    DateTime           @updatedAt

  empresa     Empresa             @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  textModels  AiConnection[]
  mediaModels AiMediaConnection[]

  @@index([empresaId])
  @@map("ai_credentials")
}

/// Modelo de texto na fila de prioridade do tenant. A chave fica em AiCredential;
/// aqui só o modelo e a ordem de tentativa (0 = principal).
model AiConnection {
  id           String   @id @default(cuid())
  empresaId    String
  credentialId String
  model        String
  /// Ordem de prioridade dentro da modalidade (0 = primeiro a ser tentado).
  priority     Int      @default(0)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  empresa    Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  credential AiCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@unique([empresaId, credentialId, model])
  @@index([empresaId, priority])
  @@map("ai_connections")
}

/// Modelo de mídia na fila de prioridade, separado por modalidade. Diferente da
/// AiConnection (texto/LLM): as de `image` são usadas SÓ em "Criar Imagem" e as
/// de `video` SÓ em "Criar Vídeo". A chave fica em AiCredential.
model AiMediaConnection {
  id           String      @id @default(cuid())
  empresaId    String
  credentialId String
  kind         AiMediaKind
  model        String
  /// Ordem de prioridade dentro da modalidade (0 = primeiro a ser tentado).
  priority     Int         @default(0)
  criadoEm     DateTime    @default(now())
  atualizadoEm DateTime    @updatedAt

  empresa    Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  credential AiCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@unique([empresaId, kind, credentialId, model])
  @@index([empresaId, kind, priority])
  @@map("ai_media_connections")
}

// ---------- Catálogo de Squads (Business Partner IA) ----------
// Catálogo GLOBAL da plataforma (não por tenant). Espelha os tipos do front:
//   ts/demo/src/app/navigation/ceoOs.ts    -> squadCatalog (id, slug, title, icon)
//   ts/demo/src/app/data/squadDetails.ts   -> description, starterQuestions, agents
// Seed: prisma/data/squads.json (gerado a partir do xlsx) via `npm run db:seed`.
//
// Por que tabelas e não JSON estático:
//   - permite CRUD/admin (criar, editar, ativar/desativar squads e agentes);
//   - ordenação explícita (campo `order`) e soft-delete (`active`);
//   - cada agente pode ter override de modelo de IA (`model`);
//   - pins por usuário deixam de viver só no client (SquadPin).
// Extensão futura (multi-tenant): um `empresaId String?` em Squad/SquadAgent
// permitiria squads custom por empresa sem quebrar o catálogo global (empresaId = null).

/// Um squad do catálogo (grupo de agentes especialistas de uma área).
model Squad {
  id           String   @id // code do catálogo, ex.: "bp.com-interna"
  slug         String   @unique // ex.: "comunicacao-interna"
  title        String // ex.: "Comunicação Interna"
  icon         String? // chave de ícone do front, ex.: "ceo.com-interna"
  /// "Quando utilizar" — descreve o contexto de uso do squad.
  description  String
  order        Int      @default(0) // ordem de exibição no catálogo
  active       Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  agents           SquadAgent[]
  starterQuestions SquadStarterQuestion[]
  starterActions   SquadStarterAction[]
  pins             SquadPin[]

  @@index([active, order])
  @@map("squads")
}

/// Um agente (referência humana personificada) dentro de um squad.
model SquadAgent {
  id           String   @id // ex.: "bp.com-interna.simon-sinek"
  squadId      String
  /// Papel do agente no squad, ex.: "Comunicação Inspiradora".
  position     String
  /// Referência humana que o agente personifica, ex.: "Simon Sinek".
  reference    String
  /// "Quem é" — frase curta sobre o agente.
  who          String
  /// "Contribuição" — o que o agente entrega ao squad.
  contribution String
  /// Prompt-base (system/developer) usado para invocar o agente.
  prompt       String
  /// Override opcional de modelo de IA; se null, usa o AiConnection da empresa.
  model        String?
  order        Int      @default(0)
  active       Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  squad Squad @relation(fields: [squadId], references: [id], onDelete: Cascade)

  @@index([squadId, order])
  @@map("squad_agents")
}

/// Pergunta inicial / ponto de partida sugerido para um squad (as "FAQ" do xlsx).
model SquadStarterQuestion {
  id      String @id @default(cuid())
  squadId String
  text    String
  order   Int    @default(0)

  squad Squad @relation(fields: [squadId], references: [id], onDelete: Cascade)

  @@index([squadId, order])
  @@map("squad_starter_questions")
}

/// Ação executável sugerida para um squad — uma tarefa que um agente de IA
/// pode realizar e entregar (ex.: "Gerar uma matriz de riscos estratégicos").
model SquadStarterAction {
  id      String @id @default(cuid())
  squadId String
  text    String
  order   Int    @default(0)

  squad Squad @relation(fields: [squadId], references: [id], onDelete: Cascade)

  @@index([squadId, order])
  @@map("squad_starter_actions")
}

/// Squad fixado por um usuário no menu lateral (substitui o estado client-side).
model SquadPin {
  id        String   @id @default(cuid())
  usuarioId String
  squadId   String
  order     Int      @default(0) // ordem em que o usuário fixou
  criadoEm  DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  squad   Squad   @relation(fields: [squadId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, squadId])
  @@index([usuarioId])
  @@map("squad_pins")
}

// ---------- Memória da IA (por tenant) ----------
// Base de conhecimento de longo prazo do BeHuman por empresa. Cada memória
// ativa é injetada no contexto das respostas dos squads/chat. Espelha o front:
//   ts/demo/src/app/data/memoria.ts -> MemoryItem
// O tema (`categoria`) referencia o slug de um squad do catálogo (ex.: "cultura",
// "gestao-de-pessoas") OU um tema transversal: "estrategico" | "hierarquico" |
// "historico". É um texto livre de propósito — não há FK para Squad porque os
// temas transversais não são squads e o catálogo pode evoluir.

/// Um fato que a IA "lembra" sobre a empresa.
model Memoria {
  id           String           @id @default(cuid())
  empresaId    String
  /// Tema: slug de um squad ou id de tema transversal.
  categoria    String
  /// Resumo curto (uma linha).
  titulo       String
  /// O fato em si, como a IA o registrou.
  conteudo     String
  /// De onde a memória veio (ex.: "Chat · Onboarding", "Manual").
  origem       String           @default("Manual")
  confianca    MemoriaConfianca @default(alta)
  /// Quando ativa, a IA usa esta memória nas respostas.
  ativa        Boolean          @default(true)
  /// Definição corporativa (read-only): não pode ser desativada, alterada ou
  /// removida pelo usuário. Memórias criadas pelo usuário têm `false`.
  corporativa  Boolean          @default(false)
  /// Data em que a IA aprendeu/atualizou o fato (exibida no card).
  aprendidaEm  DateTime         @default(now())
  criadoEm     DateTime         @default(now())
  atualizadoEm DateTime         @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId, ativa])
  @@map("memorias")
}

// ---------- Insights da IA (por tenant) ----------
// Sinais estratégicos que a IA gera a partir do material das áreas — hoje, a
// partir de cada ata/resumo de reunião salvo na Memória. Espelha o front:
//   ts/demo/src/app/data/insights.ts -> Insight
// A página de Insights (Business Partner) lê estes registros. `severidade`
// define a cor/urgência do card; `liderado`, quando presente, é a pessoa (ou
// "Todos") a que o insight se refere.

/// Severidade do insight — controla a cor do card no front.
enum InsightSeveridade {
  secondary // Ação necessária
  warning // Atenção
  success // Sucesso
  light // Para refletir
}

/// Um sinal estratégico gerado pela IA para o líder.
model Insight {
  id         String            @id @default(cuid())
  empresaId  String
  /// Título curto (uma linha).
  titulo     String
  /// Explicação/implicação para o negócio.
  descricao  String
  /// Rótulo do tipo exibido no badge (ex.: "Rotatividade", "Engajamento").
  tipo       String            @default("Insight")
  severidade InsightSeveridade @default(light)
  /// Pessoa ou time a que o insight se refere (nome ou "Todos"). Opcional.
  liderado   String?
  /// De onde o insight veio (ex.: "Áudio", "Transcrição", "Manual").
  origem     String            @default("Manual")
  /// Memória de origem (ata/resumo) que gerou o insight, quando houver.
  memoriaId  String?
  criadoEm   DateTime          @default(now())

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId])
  @@map("insights")
}

// ---------- Vault de notas (.md) por tenant ----------
// A "Memória" do usuário no sentido literal: os arquivos .md da pasta que ele
// abre na tela Memória (o mesmo conjunto que gera o grafo). O front lê os .md
// no navegador (File System Access API) e sincroniza aqui, um registro por
// arquivo. O /ai/prompt recupera as notas relevantes por busca textual
// (Postgres full-text) e as injeta no contexto. Distinto de `Memoria`, que são
// as diretrizes/regras curadas.

/// Uma nota .md sincronizada do vault do usuário.
model VaultNota {
  id             String   @id @default(cuid())
  empresaId      String
  /// Repositório (contexto) de onde a nota veio. Isola o índice entre
  /// repositórios: cada um sincroniza a sua pasta sem apagar nem ler o do
  /// outro. Espelha o mesmo isolamento que `Conversa.repositorioId` já faz
  /// para o histórico.
  repositorioId  String
  /// Caminho relativo dentro da pasta (ex.: "Reuniões/2026-01.md").
  /// Único por empresa + repositório — dois repositórios podem ter um
  /// "README.md" cada, sem se sobrescreverem.
  path           String
  /// Título derivado (frontmatter `título`/`title` ou nome do arquivo).
  titulo         String
  /// Conteúdo integral do arquivo (texto).
  conteudo       String
  /// Hash do conteúdo, para pular o reprocessamento de arquivos inalterados.
  hash           String
  /// Hash com que esta nota foi classificada em categorias pela última vez.
  /// `null` = nunca classificada; diferente de `hash` = o texto mudou e a
  /// classificação está velha. É o que faz resincronizar um vault intocado
  /// custar zero token — e o que evita reprocessar para sempre uma nota que a
  /// IA classificou em NENHUMA categoria (ela fica com o hash gravado igual).
  categoriasHash String?
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, repositorioId, path])
  @@index([empresaId, repositorioId])
  @@map("vault_notas")
}

/// Vocabulário de categorias macro de um repositório, descoberto pela IA.
///
/// Não é lista fixa: a IA propõe a partir do conteúdo. Mas também não é livre
/// por nota — classificar cada nota isoladamente produz deriva ("Gestão de
/// Pessoas", "Pessoas", "RH"). Uma categoria proposta durante a atribuição
/// entra como não confirmada e só passa a valer quando 2+ notas a propõem.
model VaultCategoria {
  id            String   @id @default(cuid())
  empresaId     String
  repositorioId String
  /// Chave de merge: sem acento, sem caixa, sem pontuação. Espelha `slugTag`
  /// do front (ts/demo/src/app/pages/ceo/grafo-tags.ts) — as duas
  /// implementações têm de concordar, senão o grafo não acha a categoria.
  slug          String
  label         String
  /// Frase curta da IA sobre o que a categoria cobre. Entra no prompt de
  /// atribuição para o modelo não reinterpretar o rótulo a cada nota.
  definicao     String?
  /// Só categorias confirmadas viram nó no grafo.
  confirmada    Boolean  @default(false)
  /// Quantas notas já propuseram esta categoria (2 confirma).
  propostas     Int      @default(0)
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, repositorioId, slug])
  @@index([empresaId, repositorioId])
  @@map("vault_categorias")
}

/// Atribuição nota↔categoria. `hash` é o do conteúdo no momento da
/// classificação, para invalidar quando o texto muda.
model VaultNotaCategoria {
  id            String   @id @default(cuid())
  empresaId     String
  repositorioId String
  path          String
  categoriaSlug String
  hash          String
  criadoEm      DateTime @default(now())

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, repositorioId, path, categoriaSlug])
  @@index([empresaId, repositorioId, path])
  @@index([empresaId, repositorioId, categoriaSlug])
  @@map("vault_nota_categorias")
}

// ---------- Conectores (integrações) por tenant ----------
// O catálogo de conectores é estático e global (espelha o front em
// ts/demo/src/app/data/conectores.ts; cópia do backend em
// src/conectores/catalog.ts). Aqui guardamos apenas o ESTADO por empresa:
// a existência da linha significa "conectado". `connectorId` é texto livre
// validado contra o catálogo no service (sem FK, mesmo critério de Memoria).

/// Um conector ativado por uma empresa.
model EmpresaConector {
  id          String   @id @default(cuid())
  empresaId   String
  /// Id do conector no catálogo (ex.: "slack", "gupy").
  connectorId String
  /// Como a conexão foi feita: "app" (UI), "mcp" (ferramenta MCP) ou
  /// "oauth" (fluxo de autorização no provedor).
  origem      String   @default("app")
  criadoEm    DateTime @default(now())

  // --- Credenciais OAuth (conectores com integração real: Slack, e-mail) ---
  /// Token de acesso do provedor, criptografado (AES-256-GCM). NUNCA exposto.
  accessTokenEncrypted  String?
  /// Refresh token criptografado, nos provedores cujo acesso expira
  /// (Gmail/Outlook). O Slack usa token de bot sem validade.
  refreshTokenEncrypted String?
  /// Quando o access token expira — antes disso renovamos pelo refresh.
  tokenExpiresAt        DateTime?
  /// Workspace/conta autorizada no provedor (ex.: nome do time Slack ou
  /// e-mail da caixa autorizada).
  teamId                String?
  teamName              String?
  /// Scopes concedidos na autorização, separados por vírgula.
  scopes                String?

  // --- Token da pessoa que autorizou (Slack: OAuth v2 `authed_user`) ---
  /// Criptografado. É o único que lê as conversas da pessoa — DMs e canais em
  /// que ela está. O token de bot só enxerga onde o app foi adicionado, e as
  /// DMs que ele vê são as do próprio app, quase sempre vazias.
  userTokenEncrypted String?
  /// Id da pessoa que autorizou, no provedor.
  userId             String?
  /// Scopes do token de usuário, separados por vírgula.
  userScopes         String?

  // --- Credenciais informadas por formulário (conectores sem OAuth próprio:
  // Google Drive, Teams, OneDrive, WhatsApp, YouTube, Zapier) ---
  /// JSON { campo: valor } criptografado (AES-256-GCM, o mesmo CryptoService
  /// das chaves de IA). NUNCA exposto: a API devolve apenas os NOMES dos campos
  /// preenchidos. Os ids válidos por conector estão em
  /// src/conectores/credenciais-spec.ts.
  credenciaisEncrypted    String?
  /// Quando as credenciais foram gravadas pela última vez.
  credenciaisAtualizadoEm DateTime?

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, connectorId])
  @@index([empresaId])
  @@map("empresa_conectores")
}

// ---------- API keys do servidor MCP (por tenant) ----------
// Credencial que clientes MCP externos (Claude, Cursor etc.) usam para se
// conectar ao endpoint /mcp. A chave crua só é exibida UMA vez, na criação;
// em repouso guardamos apenas o hash SHA-256 (a chave tem alta entropia,
// então hash simples sem salt é suficiente).

/// Uma chave de acesso ao servidor MCP da empresa.
model McpApiKey {
  id         String    @id @default(cuid())
  empresaId  String
  /// Rótulo dado pelo usuário (ex.: "Claude do CEO").
  nome       String
  /// SHA-256 (hex) da chave crua. Lookup é feito por este hash.
  keyHash    String    @unique
  /// Últimos 4 caracteres da chave, apenas para exibição.
  last4      String
  criadoEm   DateTime  @default(now())
  /// Último uso (atualizado de forma assíncrona a cada request MCP).
  lastUsedAt DateTime?
  /// Quando revogada, a chave deixa de autenticar (soft-delete para auditoria).
  revogadaEm DateTime?

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId])
  @@map("mcp_api_keys")
}

// ---------- Conversas de chat (por usuário/tenant) ----------
// Histórico das conversas com os squads. Cada conversa guarda seus turnos
// (Mensagem). O squad/agente são referenciados por código (texto livre, sem FK)
// porque o catálogo é global e pode evoluir — mesmo critério de Memoria.

enum MensagemRole {
  user
  assistant
}

enum ConversaOrigem {
  prompt
  squad
}

/// Uma conversa: prompt da Topbar (`origem = prompt`) ou chat de squad.
model Conversa {
  id            String         @id @default(cuid())
  empresaId     String
  usuarioId     String
  origem        ConversaOrigem @default(squad)
  /// Código do squad (Squad.id). Nulo nas conversas do Prompt.
  squadId       String?
  /// Agente específico (SquadAgent.id), quando a conversa é com um único agente.
  agentId       String?
  /// Modo do Prompt (`vault` | `web` | `auto`). Nulo nos chats de squad.
  modo          String?
  /// Repositório (contexto) em que a conversa foi gerada. Isola o histórico
  /// entre repositórios e, por consequência, entre organizações.
  repositorioId String?
  /// Título exibido no histórico (derivado da 1ª mensagem do usuário).
  titulo        String
  criadoEm      DateTime       @default(now())
  atualizadoEm  DateTime       @updatedAt

  empresa   Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  usuario   Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  mensagens Mensagem[]

  @@index([empresaId, usuarioId, atualizadoEm])
  @@index([empresaId, usuarioId, origem, atualizadoEm])
  @@index([empresaId, usuarioId, repositorioId, origem, atualizadoEm], map: "conversas_repo_origem_idx")
  @@map("conversas")
}

/// Um turno de uma conversa: pergunta do usuário ou resposta da IA.
model Mensagem {
  id         String       @id @default(cuid())
  conversaId String
  role       MensagemRole
  conteudo   String
  /// Fontes/origem do turno do Prompt (`{ fontes, origem }`). Nulo no squad.
  meta       Json?
  criadoEm   DateTime     @default(now())

  conversa Conversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)

  @@index([conversaId, criadoEm])
  @@map("mensagens")
}

/// Consumo de tokens da IA: um evento por chamada ao modelo. Alimenta o contador
/// de uso do header (janelas de 1h/24h/7d). O escopo é por usuário (usuarioId),
/// dentro da empresa. Eventos com mais de 7 dias são podados (a maior janela).
model AiUsage {
  id        String   @id @default(cuid())
  empresaId String
  usuarioId String
  /// Tokens de entrada (inclui leitura/criação de cache).
  entrada   Int
  /// Tokens de saída (geração).
  saida     Int
  /// Rótulo de diagnóstico da origem (ex.: "chat", "completar", "web").
  fonte     String?
  criadoEm  DateTime @default(now())

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, criadoEm])
  @@index([empresaId])
  @@map("ai_usage")
}
