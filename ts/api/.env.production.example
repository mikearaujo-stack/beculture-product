# ===== Variáveis de ambiente do BACKEND em produção =====
# Defina TODAS no painel do Railway/Render (não faça commit dos valores reais).

# --- Banco: PostgreSQL do próprio Railway (mais simples) ---
# Adicione um serviço "PostgreSQL" no projeto Railway e, na variável abaixo do
# serviço da API, referencie a do banco: cole exatamente  ${{Postgres.DATABASE_URL}}
# (o Railway preenche a URL interna sozinho — não precisa digitar usuário/senha).
DATABASE_URL="${{Postgres.DATABASE_URL}}"

# --- Auth ---
# Gere um valor novo com:  openssl rand -base64 48
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# --- Servidor ---
# NÃO defina PORT manualmente: a plataforma injeta automaticamente.
# Origem do frontend já publicado (CORS). Aceita várias separadas por vírgula.
CORS_ORIGIN="https://beculture.ai"
FRONT_URL="https://beculture.ai/behuman"

# --- IA gerenciada (modo trial) ---
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-4-8"

# --- Criptografia das chaves de IA dos tenants (BYOK) ---
# Gere um valor novo com:  openssl rand -base64 32
ENCRYPTION_KEY=""

# --- Billing Iugu (opcional; em branco = billing simulado) ---
IUGU_API_TOKEN=""

# --- Slack (opcional). Atualize as URLs para o domínio da API publicada. ---
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
SLACK_REDIRECT_URL="https://SUA-API.up.railway.app/conectores/slack/callback"

# --- E-mail e agenda (opcional). Atualize as URLs para o domínio da API
# publicada. Gmail e Google Calendar compartilham GOOGLE_CLIENT_ID/SECRET;
# as duas Redirect URLs precisam estar cadastradas no Google Cloud. ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URL="https://SUA-API.up.railway.app/conectores/email/gmail/callback"
GOOGLE_CALENDAR_REDIRECT_URL="https://SUA-API.up.railway.app/conectores/agenda/google-calendar/callback"
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"
MICROSOFT_REDIRECT_URL="https://SUA-API.up.railway.app/conectores/email/outlook/callback"
