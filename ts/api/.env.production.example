# ===== VariÃ¡veis de ambiente do BACKEND em produÃ§Ã£o =====
# Defina TODAS no painel do Railway/Render (nÃ£o faÃ§a commit dos valores reais).

# --- Banco: PostgreSQL do prÃ³prio Railway (mais simples) ---
# Adicione um serviÃ§o "PostgreSQL" no projeto Railway e, na variÃ¡vel abaixo do
# serviÃ§o da API, referencie a do banco: cole exatamente  ${{Postgres.DATABASE_URL}}
# (o Railway preenche a URL interna sozinho â€” nÃ£o precisa digitar usuÃ¡rio/senha).
DATABASE_URL="${{Postgres.DATABASE_URL}}"
# Conexão direta do Neon (sem pooler) — usada pelo prisma migrate deploy.
DATABASE_URL_UNPOOLED="${{Postgres.DATABASE_URL}}"

# --- Auth ---
# Gere um valor novo com:  openssl rand -base64 48
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# --- Servidor ---
# NÃƒO defina PORT manualmente: a plataforma injeta automaticamente.
# Origem do frontend jÃ¡ publicado (CORS). Aceita vÃ¡rias separadas por vÃ­rgula.
CORS_ORIGIN="https://beculture.ai"
FRONT_URL="https://beculture.ai/behuman"

# --- IA gerenciada (modo trial) ---
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-4-8"

# --- Criptografia das chaves de IA dos tenants (BYOK) ---
# Gere um valor novo com:  openssl rand -base64 32
ENCRYPTION_KEY=""

# --- Billing Iugu (opcional; em branco = billing simulado) ---
IUGU_API_TOKEN=""

# --- Slack (opcional). Atualize as URLs para o domÃ­nio da API publicada. ---
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
SLACK_REDIRECT_URL="https://SUA-API.up.railway.app/conectores/slack/callback"

# --- E-mail e agenda (opcional). Atualize as URLs para o domÃ­nio da API
# publicada. Gmail e Google Calendar compartilham GOOGLE_CLIENT_ID/SECRET;
# as duas Redirect URLs precisam estar cadastradas no Google Cloud. ---
GOOGLE_CLIENT_ID=""
